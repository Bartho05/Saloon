# Database
DATABASE_URL="postgresql://user:password@localhost:5432/salao_beleza?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN=15d

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# WhatsApp (Z-API / Evolution API / Meta Cloud API)
WHATSAPP_PROVIDER="zapi" # zapi | evolution | meta
WHATSAPP_INSTANCE_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_API_URL="https://api.z-api.io"

# Optional: Email (for future use)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
