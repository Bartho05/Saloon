# =============================================================================
# VARIÁVEIS DE AMBIENTE DO BACKEND
#
# Copie para `.env` e preencha. Este arquivo NÃO tem segredo nenhum — é só o
# modelo. Os valores reais ficam no `.env`, que está no `.gitignore`.
#
# No Vercel, cada linha vira uma variável de ambiente do projeto (Settings >
# Environment Variables). Nenhuma delas deve ser marcada como pública: o
# frontend é uma SPA e não precisa ler nada daqui.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (Supabase Postgres)
# -----------------------------------------------------------------------------
#
# Use a CONEXÃO DIRETA, que é a que termina em `db.<ref>.supabase.co:5432`.
#
# Não troque pela porta 6543 (pooler) achando que é mais segura. A porta 6543
# economiza conexões, mas o modo transacional do PgBouncer desliga os
# prepared statements, e o Prisma depende deles. O resultado é lentidão em
# consulta e, pior, erro intermitente que só aparece sob carga.
#
# A string de conexão do Supabase mostra as duas. Pegue a que diz
# "URI" e não "Session pooler".
DATABASE_URL="postgresql://postgres.SUA_REFERENCIA:SUA_SENHA@db.SUA_REFERENCIA.supabase.co:5432/postgres?schema=public&sslmode=require"

# Tamanho do pool de conexões do Prisma.
#
# 5 é o padrão e serve para um salão. Suba se o banco for o Supabase gratuito
# (que tem limite de conexões) e o sistema estiver em horário de pico.
DB_POOL_SIZE=5

# -----------------------------------------------------------------------------
# IMAGENS (Supabase Storage)
# -----------------------------------------------------------------------------
#
# As três juntas ligam o armazenamento de imagens.
#
# SEM ELAS o sistema grava as fotos no DISCO — o que funciona em
# desenvolvimento e NÃO funciona no Vercel. A foto seria "enviada com
# sucesso", a URL seria gravada no banco, e a imagem apareceria quebrada para
# todo mundo, sem erro nenhum.
#
# Onde achar cada uma: no painel do Supabase, em Project Settings > API.
#   SUPABASE_URL               → Project URL
#   SUPABASE_SERVICE_ROLE_KEY  → service_role (o que começa com "eyJ..." e
#                                está na seção "service_role")
#   SUPABASE_STORAGE_BUCKET    → o nome do bucket. Crie um chamado
#                                "salao-imagens" e marque como PÚBLICO, senão
#                                as fotos dão 403.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
#
# Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Os dois precisam ser DIFERENTES entre si e diferentes dos de qualquer outro
# projeto. Token de acesso: 15 minutos. O de refresh: 15 dias.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="15d"

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"

# Domínio do FRONTEND, sem barra no final. É o que o CORS libera.
FRONTEND_URL="https://seudominio.com.br"

# Domínio do BACKEND, sem barra no final.
#
# É para onde a Z-API manda os avisos de queda e de entrega de mensagem.
# Sem esta variável, o botão "Registrar avisos" na tela de configurações do
# WhatsApp diz exatamente o que falta.
#
# Debe o domínio do BACKEND, não do frontend. Confundir os dois é o motivo
# número um de "registrei o webhook e nunca chegou nada".
BACKEND_URL="https://api.seudominio.com.br"

# -----------------------------------------------------------------------------
# WHATSAPP (Z-API)
# -----------------------------------------------------------------------------
#
# A configuração que o DONO preenche na tela (Configurações > WhatsApp) tem
# prioridade sobre estas variáveis. Elas existem para o sistema funcionar
# antes de o dono abrir a tela pela primeira vez, e para ambiente de teste.
#
# Instância e token: no painel da Z-API, em Instância > Tokens de segurança.
WHATSAPP_PROVIDER="zapi"
WHATSAPP_INSTANCE_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_API_URL="https://api.z-api.io"

# Token de SEGURANÇA DA CONTA Z-API. Opcional, mas recomendado.
#
# É uma credencial diferente do token da instância: esta vai no header
# `Client-Token` e, se preenchida, faz a Z-API recusar chamadas vindas de um
# IP não cadastrado. É o que impede alguém que descubra a sua URL de
# instância de mandar mensagem em nome do salão.
WHATSAPP_CLIENT_TOKEN=""

# -----------------------------------------------------------------------------
# ROTINAS AGENDADAS
# -----------------------------------------------------------------------------
#
# Em produção é OBRIGATÓRIA. Sem ela, /api/cron/* responde 503 e os lembretes
# de WhatsApp nunca saem — o sistema continua funcionando, o que torna a falha
# silenciosa até alguém reclamar.
#
# No Vercel, crie a variável com o nome EXATO "CRON_SECRET": o Vercel Cron a
# injeta sozinho nas requisições que ele dispara.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# -----------------------------------------------------------------------------
# SUPERADMIN
# -----------------------------------------------------------------------------
#
# Pepper do código de acesso. Entra na entrada do scrypt e NÃO fica no banco:
# com o banco inteiro vazado, quem não tem esta variável não consegue nem
# recalcular o hash para testar candidatos.
#
# O servidor NÃO SOBE sem ela. Um pepper fixo no código-fonte seria pior que
# nada — daria a impressão de proteção sem existir.
SUPERADMIN_PEPPER=""

# Semente que autoriza criar o PRIMEIRO superadmin em
# POST /superadmin/bootstrap. Sem ela o endpoint responde 503 mesmo com o
# banco vazio — a porta de instalação não fica aberta por acidente.
#
# REMOVA esta variável depois de criar o superadmin: aí a porta fecha de vez,
# porque o endpoint também recusa quando já existe uma conta.
SUPERADMIN_BOOTSTRAP_SEED=""

# -----------------------------------------------------------------------------
# LIMITES DE TAXA
# -----------------------------------------------------------------------------
#
# 600 a cada 15 min (40/min). O painel é uma SPA: cada tela dispara de 2 a 4
# chamadas, então um limite apertado expulsa o dono para a tela de login no
# meio do trabalho, sem ele ter feito nada de errado. Este valor serve para
# conter script abusing a API, não para contar a navegação de uma pessoa.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# -----------------------------------------------------------------------------
# E-MAIL (não usado ainda)
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# =============================================================================
# TESTES
# =============================================================================
#
# Copie este arquivo para `.env.test` e ajuste DUAS linhas:
#
#   DATABASE_URL  ->  schema=test   (o `public` é o banco de DESENVOLVAMENTO)
#   NODE_ENV      ->  test          (desliga os rate limiters)
#
# Os testes de integração rodam `deleteMany` em serviços, clientes,
# agendamentos e funcionários. Apontados para o schema `public`, eles apagam
# os dados do salão. `src/tests/setup.ts` recusa a execução se o `schema=test`
# não estiver presente — é a trava, não este arquivo.
#
#   copy .env.example .env.test    # Linux/macOS: cp .env.example .env.test
#   # ajuste as duas linhas acima
#   npx prisma migrate deploy       # aplica as migrations no schema test
#   npm test
# =============================================================================
