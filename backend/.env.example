# Database
DATABASE_URL="postgresql://user:password@localhost:5432/salao_beleza?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN=15d

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# WhatsApp (Z-API / Evolution API / Meta Cloud API)
WHATSAPP_PROVIDER="zapi" # zapi | evolution | meta
WHATSAPP_INSTANCE_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_API_URL="https://api.z-api.io"

# Optional: Email (for future use)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Rate Limiting
# 600 a cada 15 min (40/min). O painel é uma SPA: cada tela dispara de 2 a 4
# chamadas, então um limite apertado (o padrão antigo era 100 ≈ 7/min) expulsa
# o dono para a tela de login no meio do trabalho, sem ele ter feito nada de
# errado. Este valor serve para conter script abusing a API, não para contar
# a navegação de uma pessoa.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600


# ─────────────────────────────────────────────────────────────────────────
# TESTES
#
# Copie este arquivo para `.env.test` e ajuste DUAS linhas:
#
#   DATABASE_URL → schema=test   (o `public` é o banco de DESENVOLVIMENTO)
#   NODE_ENV     → test          (desliga os rate limiters)
#
# Os testes de integração rodam `deleteMany` em serviços, clientes,
# agendamentos e funcionários. Apontados para o schema `public`, eles apagam
# os dados do salão. `src/tests/setup.ts` recusa a execução se o
# `schema=test` não estiver presente — é a trava, não este arquivo.
#
#   copy .env.example .env.test    # Linux/macOS: cp .env.example .env.test
#   # ajuste as duas linhas acima
#   npx prisma migrate deploy       # aplica as migrations no schema test
#   npm test
# ─────────────────────────────────────────────────────────────────────────