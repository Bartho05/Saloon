// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  EMPLOYEE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id            String    @id @default(uuid())
  name          String
  phone         String    @unique
  email         String?   @unique
  passwordHash  String?
  accessCode    String?   @unique
  role          UserRole  @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  specialties   String[]  @default([])
  color         String?
  photoUrl      String?  // foto do rosto, para o cliente ver com quem vai agendar
  /// Último acesso ao painel. O superadmin usa para ver se a conta existe e
  /// está sendo usada — uma conta de dono que nunca entrou é sinal de cadastro
  /// incompleto.
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments  Appointment[] @relation("EmployeeAppointments")

  @@index([phone])
  @@index([accessCode])
  @@index([email])
  @@map("users")
}

model Client {
  id           String         @id @default(uuid())
  /// Vazio enquanto a pessoa não preencheu o cadastro (primeiro agendamento
  /// pendente). Antes era "Cliente WhatsApp", que aparecia como nome na agenda.
  fullName     String
  phone        String         @unique
  /// Anulável: quem ainda não informou a data de nascimento.
  /// O job de aniversário ignora quem é null.
  birthDate    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  appointments Appointment[]

  @@index([phone])
  @@map("clients")
}

model Service {
  id           String         @id @default(uuid())
  name         String
  description  String?
  durationMinutes Int
  price        Float          @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  appointments Appointment[]

  @@index([isActive])
  @@map("services")
}

model Appointment {
  id          String             @id @default(uuid())
  clientId    String
  employeeId  String
  serviceId   String
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus  @default(SCHEDULED)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee    User               @relation("EmployeeAppointments", fields: [employeeId], references: [id], onDelete: Cascade)
  service     Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([employeeId, startsAt])
  @@index([clientId, startsAt])
  @@index([status])
  @@map("appointments")
}

/// Administrador da plataforma: o nível acima do dono do salão.
///
/// Existe para as duas pontas que o dono não cobre: criar o PRIMEIRO
/// proprietário quando o sistema ainda está vazio, e enxergar todos os
/// salões de uma vez. O dono cuida de um salão; este cuida da instalação.
///
/// O código de acesso NUNCA é gravado em texto. Ver `superadminCrypto.ts`:
/// o que vai para o banco é o resultado de um scrypt com salt por conta e um
/// pepper do servidor — não há como voltar do hash para o código.
model SuperAdmin {
  id        Int      @id @default(1)
  name      String
  email     String   @unique

  /// scrypt(código + salt + pepper) em base64. Irreversível por construção.
  codeHash  String
  /// Salt aleatório de 16 bytes por conta, em base64.
  codeSalt  String
  /// Identificação do código para o operador ("a3f…9c2"), sem revelar nada
  /// que ajude a recuperá-lo. Serve para saber qual código está ativo.
  codeFingerprint String
  /// Quando o código foi gerado. O código só é exibido uma vez, na criação.
  codeCreatedAt   DateTime @default(now())
  codeRotatedAt   DateTime?

  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?

  /// Trava progressiva: N tentativas erradas bloqueiam por N minutos.
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt


  @@map("super_admins")
}

/// Trilha de auditoria do superadmin.
/// Trilha de auditoria de TUDO que acontece no sistema.
///
/// Uma tabela so, e nao uma por area. Duas tabelas de log soam corretas, mas na
/// pratica criam a pergunta "qual dos dois eu olho?" — e a resposta honesta
/// seria "os dois, e junte as partes". O superadmin tambem entra aqui: o que
/// diferencia um acesso maximo nao e a tabela onde ele e gravado, e o campo
/// `actorKind`.
///
/// Sem chave estrangeira para o autor, de proposito: o log precisa sobreviver
/// a conta. Se alguem apaga o proprio acesso e sai, o rastro e justamente o
/// que sobra.
model AuditLog {
  id      Int    @id @default(autoincrement())
  /// Codigo da acao. A lista fechada vive em `auditService.ts`; texto livre
  /// aqui vira bagunca depois de um mes de uso.
  action  String

  /// O que foi tocado: "appointment", "client", "service", "employee",
  /// "settings", "whatsapp", "auth", "superadmin", "cron".
  entity   String?
  entityId String?

  /// SUCCESS ou FAILURE. Sem isso, "login" e "tentativa de login" ficam
  /// indistinguiveis numa busca por `action`.
  outcome String @default("SUCCESS")

  /// Quem agiu: OWNER | EMPLOYEE | CLIENT | SUPERADMIN | SYSTEM | ANONYMOUS
  actorKind  String
  actorId    String?
  /// Nome/e-mail no momento da acao, em texto. A pessoa pode ser renomeada
  /// depois, e o log precisa continuar legivel como era na hora.
  actorLabel String?

  /// Frase curta em portugues, ja pronta para a tela. Ler um log nao pode
  /// exigir abrir a tabela e traduzir um codigo.
  summary String

  /// Contexto extra (de/para, telefone, motivo). NUNCA guarda segredo: sem
  /// senha, sem token, sem hash.
  metadata Json?

  /// Origem da acao, para responder "de onde veio isso?".
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
  @@index([actorKind, actorId])
  @@index([outcome, createdAt])
  @@map("audit_logs")
}

/// Código de verificação enviado ao cliente por WhatsApp.
///
/// Antes isto vivia num `Map` na memória do processo. Funcionava em
/// desenvolvimento e quebraria em produção serverless: cada instância tem a
/// sua própria memória, então o `POST /request-code` podia cair na instância A
/// e o `POST /verify-code` na B — e o cliente recebia um código que o sistema
/// "não conhecia". É o tipo de falha que só aparece depois do deploy.
///
/// A tabela também resolve a limpeza: o `Map` só perdia os códigos quando o
/// processo reiniciava, então códigos expirados ficavam lá até alguém pedir
/// outro para o mesmo telefone.
model VerificationCode {
  id        String   @id @default(cuid())
  /// Telefone só com dígitos, já normalizado (o mesmo formato gravado no
  /// cliente). Índice porque toda verificação busca por ele.
  phone     String
  /// SHA-256 do código, não o código.
  ///
  /// Vale ser honesto sobre o que isto protege: um hash de 6 dígitos com o
  /// telefone do lado não resiste a quem já leu a tabela — um milhão de SHA-256
  /// é instantâneo. A proteção de verdade é a expiração de 10 minutos, o uso
  /// único e o limite de tentativas. O hash serve para o código não estar em
  /// texto numa tabela que muito mais gente lê do que deveria.
  codeHash  String
  /// Tentativas erradas já feitas neste código. Zera no acerto.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
  @@map("verification_codes")
}

model SalonSettings {
  id                 Int      @id @default(1)
  name               String
  phone              String?
  email              String?
  address            String?
  description        String?
  businessHours      Json     // { "0": null, "1": { "open": "09:00", "close": "19:00" }, ... }
  timezone           String   @default("America/Sao_Paulo")
  birthdayMessage    String?  // Template: "Olá {nome}! Feliz aniversário! Venha comemorar com a gente no {salao} 🎂"
  whatsappApiConfig  Json?    // { "provider": "zapi", "instanceId": "", "token": "", "url": "" }
  cancellationHours  Int      @default(2)
  bufferMinutes      Int      @default(10)
  slotInterval       Int      @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("salon_settings")
}