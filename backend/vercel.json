{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },

  "crons": [
    {
      "path": "/api/cron/aniversarios",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/lembretes",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/limpeza",
      "schedule": "0 6 * * *"
    }
  ]
}
