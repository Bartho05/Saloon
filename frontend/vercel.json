{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",

  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],

  "crons": [
    {
      "path": "/api/cron/aniversarios",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/lembretes",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/limpeza",
      "schedule": "0 6 * * *"
    }
  ]
}
